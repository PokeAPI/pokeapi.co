---
import {Icon} from "@astrojs/starlight/components";
---

<a
  href="https://github.com/pokeapi/pokeapi"
  rel="me"
  target="_blank"
  class="m-[-0.5em] flex items-center justify-center p-[0.5em] text-[#c9d1d9] transition-all duration-180 ease-in-out hover:-translate-y-px hover:opacity-75 [:root[data-theme=light]_&]:text-[#24292e]"
  aria-label="GitHub"
>
  <span class="sr-only">GitHub</span>
  <Icon name="github" size="1.2rem" />
</a>

<a
  href="https://discord.gg/BpjJcKK4TC"
  target="_blank"
  rel="noopener noreferrer"
  class="m-[-0.5em] flex items-center justify-center p-[0.5em] text-(--sl-color-gray-2) transition-colors hover:text-(--sl-color-white) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--sl-color-accent)"
  aria-label="Join PokéAPI on Discord"
  title="Join PokéAPI on Discord"
>
  <Icon name="discord" size="1.2rem" />
</a>
